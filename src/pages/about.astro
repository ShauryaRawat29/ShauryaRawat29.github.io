---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE, RESUME_PATH } from '@/site.config';

const tools = [
  'Python',
  'C',
  'C++',
  'JavaScript',
  'TypeScript',
  'SQL',
  'XGBoost',
  'SHAP',
  'scikit-learn',
  'FastAPI',
  'FAISS',
  'sentence-transformers',
  'RAG',
  'Prompt Engineering',
  'Next.js',
  'React',
  'Docker',
  'Linux',
  'Git',
  'GitHub Actions',
  'pytest',
  'fail2ban',
  'nftables',
  'auditd',
  'OpenVAS',
  'Trivy',
  'Sigma',
  'Lynis',
  'BloodHound',
  'Prometheus',
  'Grafana',
  'Loki',
  'Traefik',
  'Proxmox VE',
];

const certifications = [
  'CS50: Introduction to Computer Science — Harvard University (edX)',
  'Python for Data Science — NPTEL',
  'Demystifying Networking — IIT Bombay',
  'Machine Learning Crash Course — Google',
  'ChatGPT Prompt Engineering for Developers — DeepLearning.AI',
];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {SITE.role}.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        I'm a B.Tech CSE (IoT) student at Amity University, Noida (2023–2027), currently an AI
        Engineering Intern at Syphyr Pvt. Ltd. (May–Jul 2026). I build applied machine learning —
        systems that solve real problems and explain themselves, not black boxes.
      </p>
      <p>
        At Syphyr, I shipped 3 proof-of-concept AI applications in Python — document triage, intent
        classification, data extraction — with 2 advancing to live client demos. Built automated
        evaluation harnesses across 5+ client models, cutting manual testing effort ~30%.
      </p>
      <p>
        My projects follow one rule: ship something usable. PhishGuard is a deployed, live
        phishing detector with SHAP explanations on every prediction (XGBoost on 468K URLs,
        {'<1% adversarial evasion'}). QueryDocs runs a full RAG pipeline at zero cost, with no API
        keys required. The AI Essay Detector gives per-sentence evidence instead of a lazy binary
        verdict (200+ tests, ruff + mypy clean).
      </p>
      <p>
        Outside of ML, I manage a Proxmox VE homelab (15+ Ubuntu VMs) with VLAN segmentation,
        DNS (Pi-hole/Unbound), reverse proxy (Traefik), centralized logging (Loki), and metrics
        (Prometheus/Grafana). Implemented hardening baseline: fail2ban, nftables, SSH-key-only
        access, auditd, unattended-upgrades; Lynis compliance scoring. Built vulnerability
        management pipeline with OpenVAS/Trivy scans, CVE triage, and Sigma rule validation.
        Active Directory security lab: Kerberos delegation auditing, Kerberoasting/AS-REP roasting,
        BloodHound attack-path analysis, MITRE ATT&CK-mapped detection rule authoring.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tools</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Certifications</p>
      <ul class="space-y-1.5">
        {
          certifications.map((cert) => (
            <li class="text-ink-soft text-sm">
              <span class="text-signal mr-2" aria-hidden="true">▹</span>
              {cert}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <Button href={RESUME_PATH} variant="solid">Download resume</Button>
      <Button href={`mailto:${SITE.email}`} variant="ghost">Get in touch</Button>
    </div>
  </section>
</BaseLayout>